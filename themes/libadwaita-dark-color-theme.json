  "semanticTokenColors": {
    "namespace": "#f5c211",
    "class": {
      "foreground": "#5bc8af",
      "bold": true
    },
    "struct": {
      "foreground": "#5bc8af",
      "bold": true
    },
    "enum": {
      "foreground": "#5bc8af",
      "bold": true
    },
    "interface": {
      "foreground": "#5bc8af",
      "bold": true
    },
    "type": {
      "foreground": "#5bc8af",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#5bc8af",
      "italic": true
    },
    "function": "#62a0ea",
    "method": "#62a0ea",
    "macro": "#7d8ac7",
    "decorator": "#7d8ac7",
    "variable": "#deddda",
    "variable.readonly": "#7d8ac7",
    "variable.defaultLibrary": {
      "foreground": "#ffa348",
      "italic": true
    },
    "parameter": "#ffbe6f",
    "property": "#8ff0a4",
    "enumMember": "#7d8ac7",
    "keyword": {
      "foreground": "#ffa348",
      "bold": true
    },
    "modifier": {
      "foreground": "#ffa348",
      "bold": true
    },
    "comment": {
      "foreground": "#77767b",
      "italic": true
    },
    "string": "#5bc8af",
    "number": "#7d8ac7",
    "regexp": "#c061cb",
    "operator": "#c0bfbc",
    "lifetime": {
      "foreground": "#ffa348",
      "bold": false
    }
  },
  "tokenColors": [
    {
      "name": "Comments (def:comment)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#77767b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comments & Shebangs (def:doc-comment-element, def:shebang)",
      "scope": [
        "comment.block.documentation",
        "comment.documentation",
        "keyword.other.documentation",
        "storage.type.class.jsdoc",
        "punctuation.definition.comment.shebang",
        "comment.line.number-sign.shebang"
      ],
      "settings": {
        "foreground": "#9a9996",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords & Statements (def:statement)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.word",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.struct",
        "storage.type.enum",
        "storage.type.interface",
        "storage.type.trait",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#ffa348",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow & Operator Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#c0bfbc"
      }
    },
    {
      "name": "Types, Classes & Storage Classes (def:type, c:storage-class, python:class-name)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.interface",
        "entity.other.inherited-class",
        "storage.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.c",
        "storage.type.cs",
        "storage.type.go",
        "storage.type.rust",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#5bc8af",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods (def:function, python:builtin-function)",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "meta.function-call.generic",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#62a0ea"
      }
    },
    {
      "name": "Strings (def:string)",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5bc8af"
      }
    },
    {
      "name": "Numbers, Booleans & Constants (def:number, def:boolean, def:constant)",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#7d8ac7"
      }
    },
    {
      "name": "Special Characters & Escape Sequences (def:special-char, c:signal-name)",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.section.embedded",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#f66151"
      }
    },
    {
      "name": "Format Specifiers & Regular Expressions (c:printf, go:printf)",
      "scope": [
        "string.regexp",
        "constant.other.color",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#c061cb"
