  "semanticTokenColors": {
    "namespace": "#d38b09",
    "class": {
      "foreground": "#218787",
      "bold": true
    },
    "struct": {
      "foreground": "#218787",
      "bold": true
    },
    "enum": {
      "foreground": "#218787",
      "bold": true
    },
    "interface": {
      "foreground": "#218787",
      "bold": true
    },
    "type": {
      "foreground": "#218787",
      "bold": true
    },
    "typeParameter": {
      "foreground": "#218787",
      "italic": true
    },
    "function": "#1c71d8",
    "method": "#1c71d8",
    "macro": "#4e57ba",
    "decorator": "#4e57ba",
    "variable": "#3d3846",
    "variable.readonly": "#4e57ba",
    "variable.defaultLibrary": {
      "foreground": "#c64600",
      "italic": true
    },
    "parameter": "#986a44",
    "property": "#26a269",
    "enumMember": "#4e57ba",
    "keyword": {
      "foreground": "#c64600",
      "bold": true
    },
    "modifier": {
      "foreground": "#c64600",
      "bold": true
    },
    "comment": {
      "foreground": "#77767b",
      "italic": true
    },
    "string": "#218787",
    "number": "#4e57ba",
    "regexp": "#813d9c",
    "operator": "#504e55",
    "lifetime": {
      "foreground": "#c64600",
      "bold": false
    }
  },
  "tokenColors": [
    {
      "name": "Comments (def:comment)",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#77767b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc Comments & Shebangs (def:doc-comment-element, def:shebang)",
      "scope": [
        "comment.block.documentation",
        "comment.documentation",
        "keyword.other.documentation",
        "storage.type.class.jsdoc",
        "punctuation.definition.comment.shebang",
        "comment.line.number-sign.shebang"
      ],
      "settings": {
        "foreground": "#504e55",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords & Statements (def:statement)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.word",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.struct",
        "storage.type.enum",
        "storage.type.interface",
        "storage.type.trait",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#c64600",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow & Operator Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#504e55"
      }
    },
    {
      "name": "Types, Classes & Storage Classes (def:type, c:storage-class, python:class-name)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.interface",
        "entity.other.inherited-class",
        "storage.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.c",
        "storage.type.cs",
        "storage.type.go",
        "storage.type.rust",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#218787",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions & Methods (def:function, python:builtin-function)",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "meta.function-call.generic",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#1c71d8"
      }
    },
    {
      "name": "Strings (def:string)",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#218787"
      }
    },
    {
      "name": "Numbers, Booleans & Constants (def:number, def:boolean, def:constant)",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "constant.other",
        "variable.other.constant",
        "support.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#4e57ba"
      }
    },
    {
      "name": "Special Characters & Escape Sequences (def:special-char, c:signal-name)",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.section.embedded",
        "keyword.other.unit"
      ],
      "settings": {
